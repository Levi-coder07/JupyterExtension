      "relationships": [
        {
          "markdownPortion": {
            "text": "Let us replace Age with ordinals based on these bands.",
            "startOffset": 0,
            "endOffset": 54
          },
          "codeTarget": {
            "id": "cell-52",
            "index": 52,
            "metadata": {
              "_cell_guid": "797b986d-2c45-a9ee-e5b5-088de817c8b2",
              "_uuid": "ee13831345f389db407c178f66c19cc8331445b0"
            },
            "scope": "excerpt",
            "portion": {
              "text": "for dataset in combine:    \n    dataset.loc[ dataset['Age'] <= 16, 'Age'] = 0\n    dataset.loc[(dataset['Age'] > 16) & (dataset['Age'] <= 32), 'Age'] = 1\n    dataset.loc[(dataset['Age'] > 32) & (dataset['Age'] <= 48), 'Age'] = 2\n    dataset.loc[(dataset['Age'] > 48) & (dataset['Age'] <= 64), 'Age'] = 3\n    dataset.loc[ dataset['Age'] > 64, 'Age']\ntrain_df.head()",
              "startOffset": 0,
              "endOffset": 363
