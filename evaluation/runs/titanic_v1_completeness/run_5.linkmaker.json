            },
            "scope": "excerpt",
            "portion": {
              "text": "for dataset in combine:\n    dataset['Sex'] = dataset['Sex'].map( {'female': 1, 'male': 0} ).astype(int)\n\ntrain_df.head()",
              "startOffset": 0,
